PORT=3000
NODE_ENV=production
DB_FILE=./data/panel.db
JWT_SECRET=
SETUP_TOKEN=
DEMO_MODE=false
SIMULATION_MODE=true
METRICS_INTERVAL_MS=2000
METRICS_RETENTION_HOURS=48
# CurseForge API key from https://console.curseforge.com/ (optional - Modrinth works without any key)
CURSEFORGE_API_KEY=
CORS_ORIGINS=
TRUST_PROXY=0
AUDIT_RETENTION_DAYS=90
SERVER_HOST=0.0.0.0
MAX_SERVERS=50
DEFAULT_PORT=25565
DEFAULT_RAM_MB=4096
DEFAULT_CPU_CORES=8
DEFAULT_DISK_SPACE_MB=1000
LOG_LEVEL=info
LOG_FILE=./logs/server.log
MAX_LOG_SIZE_MB=10
BACKUP_COUNT=5
MAX_UPLOAD_SIZE_MB=500
ALLOWED_UPLOAD_TYPES=zip,jar,modpack
UPLOADDESTINATION=./uploads
